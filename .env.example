# Copy file này thành .env rồi điền key thật. .env đã bị gitignore.
# Lấy key miễn phí tại https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Quota free tier thay đổi theo model VÀ theo thời điểm — đừng tin bài blog,
